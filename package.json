{
  "name": "@deepseek-ai/dsh-ide-context",
  "version": "0.1.0",
  "description": "DeepSeek Harness bundle: inject the user's IDE context (open editors + current selection) into each turn, via the Claude Code IDE WebSocket bridge (IntelliJ IDEA & VS Code).",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./invariant": "./invariant.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "invariant.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build.mjs",
    "check:build": "node check-build.mjs",
    "test": "node smoke-test.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
